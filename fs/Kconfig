# The file systems of ours (fs/): not choices, Darwin's root and /private/var are on them.

config FS_APFS
	def_bool y
	help
	  A read/write APFS (fs/apfs/, bsd/miscfs/apfs/): the root image and the system image.

config FS_RAMFS
	def_bool y
	help
	  The RAM file system /private/var lives in (fs/ramfs/).

config FS_HFS
	def_bool y
	help
	  Apple's HFS Plus, read/write and journaled, built in (bsd/hfs: Apple's release, kernel/UPSTREAM's HFS_*,
	  with fs/hfs/ and kernel/patches/0008-hfs.patch): the data volume on the phone's flash, /private/var kept
	  between boots (init's var_hfs=).
