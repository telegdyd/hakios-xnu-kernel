@@ -4498,6 +4509,218 @@ int hfs_vnop_rename (struct vnop_rename_args *args) {
  * been locked.  By taking the rsrc fork vnodes up front we ensure that they 
  * cannot be recycled, and that the situation mentioned above cannot happen.
  */
+
+/*
+ * HakiOS: renamex_np(2) RENAME_SWAP, the two names exchanged at once. Darwin saves files "atomically" by writing a
+ * new copy and swapping it in -- usermanagerd's persona manifest and user sessions in /private/var/keybags among
+ * them; with ENOTSUP the manifest stays the empty one it started from, no persona is ever found, and the container
+ * lookups of lsd, appprotectiond and the rest fail (INVALID_PERSONA): no lock screen. ramfs does it as well.
+ *
+ * Two regular files or symbolic links, neither a hard link: three catalog renames in one journal transaction --
+ * the first file into the private metadata directory under a name of its file ID, the second into the first's place,
+ * the first into the second's -- so the volume has either the two names as they were or exchanged. The files keep
+ * their IDs, contents and attributes; each now has the other's name and parent.
+ */
+static int
+hfs_rename_swap(struct vnop_renamex_args *ap)
+{
+	struct vnode *fdvp = ap->a_fdvp, *fvp = ap->a_fvp, *tdvp = ap->a_tdvp, *tvp = ap->a_tvp;
+	struct componentname *fcnp = ap->a_fcnp, *tcnp = ap->a_tcnp;
+	struct proc *p = vfs_context_proc(ap->a_context);
+	struct hfsmount *hfsmp = VTOHFS(tdvp);
+	struct cnode *fdcp, *fcp, *tdcp, *tcp, *error_cnode;
+	struct cat_desc f_desc, t_desc, s_desc, f_at_t, t_at_f, out_s, out_t, out_f, undo;
+	char swapname[32];
+	cat_cookie_t cookie;
+	int got_cookie = 0, started_tr = 0, lockflags, error, step = 0;
+
+	if (tvp == NULLVP) {
+		return ENOENT;
+	}
+	if (fvp == tvp) {
+		return 0;
+	}
+	if (!(vnode_isreg(fvp) || vnode_islnk(fvp)) || !(vnode_isreg(tvp) || vnode_islnk(tvp)) ||
+	    hfsmp->hfs_private_desc[FILE_HARDLINKS].cd_cnid == 0) {
+		return ENOTSUP;
+	}
+	error = hfs_lockfour(VTOC(fdvp), VTOC(fvp), VTOC(tdvp), VTOC(tvp), HFS_EXCLUSIVE_LOCK, &error_cnode);
+	if (error) {
+		return error;
+	}
+	fdcp = VTOC(fdvp);
+	fcp = VTOC(fvp);
+	tdcp = VTOC(tdvp);
+	tcp = VTOC(tvp);
+
+	if ((fcp->c_flag | tcp->c_flag) & (C_NOEXISTS | C_DELETED)) {
+		error = ENOENT;
+		goto unlock;
+	}
+	if (ISSET(fcp->c_flag, C_HARDLINK) || ISSET(tcp->c_flag, C_HARDLINK)) {
+		error = ENOTSUP;
+		goto unlock;
+	}
+	if (((fcp->c_bsdflags | tcp->c_bsdflags) & (IMMUTABLE | APPEND)) ||
+	    ((fdcp->c_bsdflags | tdcp->c_bsdflags) & APPEND)) {
+		error = EPERM;
+		goto unlock;
+	}
+	/* (looked up without the locks: the names must still lead to these two, or the system call is driven again) */
+	if (fcp->c_parentcnid != fdcp->c_fileid || tcp->c_parentcnid != tdcp->c_fileid) {
+		error = ERECYCLE;
+		goto unlock;
+	}
+
+	fdcp->c_flag |= C_DIR_MODIFICATION;
+	if (fdvp != tdvp) {
+		tdcp->c_flag |= C_DIR_MODIFICATION;
+	}
+	cache_purge(fvp);
+	cache_purge(tvp);
+
+	bzero(&f_desc, sizeof(f_desc));
+	f_desc.cd_nameptr = (const u_int8_t *)fcnp->cn_nameptr;
+	f_desc.cd_namelen = fcnp->cn_namelen;
+	f_desc.cd_parentcnid = fdcp->c_fileid;
+	f_desc.cd_flags = fcp->c_desc.cd_flags & ~(CD_HASBUF | CD_DECOMPOSED);
+	f_desc.cd_cnid = fcp->c_cnid;
+
+	bzero(&t_desc, sizeof(t_desc));
+	t_desc.cd_nameptr = (const u_int8_t *)tcnp->cn_nameptr;
+	t_desc.cd_namelen = tcnp->cn_namelen;
+	t_desc.cd_parentcnid = tdcp->c_fileid;
+	t_desc.cd_flags = tcp->c_desc.cd_flags & ~(CD_HASBUF | CD_DECOMPOSED);
+	t_desc.cd_cnid = tcp->c_cnid;
+
+	/* the first file's interim name: of its file ID, in the private directory, which nothing looks into */
+	bzero(&s_desc, sizeof(s_desc));
+	s_desc.cd_namelen = (int)snprintf(swapname, sizeof(swapname), "swap%u", fcp->c_fileid);
+	s_desc.cd_nameptr = (const u_int8_t *)swapname;
+	s_desc.cd_parentcnid = hfsmp->hfs_private_desc[FILE_HARDLINKS].cd_cnid;
+	s_desc.cd_flags = f_desc.cd_flags;
+	s_desc.cd_cnid = fcp->c_cnid;
+
+	/* each where the other was */
+	t_at_f = f_desc;
+	t_at_f.cd_cnid = tcp->c_cnid;
+	t_at_f.cd_flags = t_desc.cd_flags;
+	f_at_t = t_desc;
+	f_at_t.cd_cnid = fcp->c_cnid;
+	f_at_t.cd_flags = f_desc.cd_flags;
+
+	bzero(&out_s, sizeof(out_s));
+	bzero(&out_t, sizeof(out_t));
+	bzero(&out_f, sizeof(out_f));
+
+	if ((error = hfs_start_transaction(hfsmp)) != 0) {
+		goto out;
+	}
+	started_tr = 1;
+	if ((error = cat_preflight(hfsmp, CAT_RENAME + CAT_RENAME + CAT_RENAME, &cookie, p))) {
+		goto out;
+	}
+	got_cookie = 1;
+
+	lockflags = hfs_systemfile_lock(hfsmp, SFL_CATALOG, HFS_EXCLUSIVE_LOCK);
+	error = cat_rename(hfsmp, &f_desc, &hfsmp->hfs_private_desc[FILE_HARDLINKS], &s_desc, &out_s);
+	if (!error) {
+		step = 1;
+		error = cat_rename(hfsmp, &t_desc, &fdcp->c_desc, &t_at_f, &out_t);
+	}
+	if (!error) {
+		step = 2;
+		error = cat_rename(hfsmp, &s_desc, &tdcp->c_desc, &f_at_t, &out_f);
+	}
+	if (error) {
+		/* back as it was, as far as it went (a name that cannot be put back is reported, the file kept) */
+		int undo_error = 0;
+
+		if (step == 2) {
+			bzero(&undo, sizeof(undo));
+			undo_error = cat_rename(hfsmp, &t_at_f, &tdcp->c_desc, &t_desc, &undo);
+			cat_releasedesc(&undo);
+		}
+		if (step >= 1 && !undo_error) {
+			bzero(&undo, sizeof(undo));
+			undo_error = cat_rename(hfsmp, &s_desc, &fdcp->c_desc, &f_desc, &undo);
+			cat_releasedesc(&undo);
+		}
+		if (undo_error) {
+			printf("hfs_rename_swap: %s and %s left after step %d: %d, then %d\n", fcnp->cn_nameptr,
+			    tcnp->cn_nameptr, step, error, undo_error);
+		}
+		if (error == EEXIST) {
+			error = ERECYCLE;
+		}
+	}
+	hfs_systemfile_unlock(hfsmp, lockflags);
+	cat_releasedesc(&out_s);
+	if (error) {
+		cat_releasedesc(&out_t);
+		cat_releasedesc(&out_f);
+		goto out;
+	}
+
+	/* the cnodes and the directories as the catalog now has them */
+	replace_desc(fcp, &out_f);
+	fcp->c_parentcnid = tdcp->c_fileid;
+	fcp->c_hint = 0;
+	replace_desc(tcp, &out_t);
+	tcp->c_parentcnid = fdcp->c_fileid;
+	tcp->c_hint = 0;
+	fcp->c_touch_chgtime = TRUE;
+	tcp->c_touch_chgtime = TRUE;
+	fcp->c_flag |= C_MODIFIED;
+	tcp->c_flag |= C_MODIFIED;
+	(void) hfs_update(fvp, 0);
+	(void) hfs_update(tvp, 0);
+
+	fdcp->c_dirchangecnt++;
+	fdcp->c_touch_chgtime = TRUE;
+	fdcp->c_touch_modtime = TRUE;
+	fdcp->c_flag |= C_MODIFIED;
+	hfs_incr_gencount(fdcp);
+	(void) hfs_update(fdvp, 0);
+	if (fdvp != tdvp) {
+		tdcp->c_dirchangecnt++;
+		tdcp->c_touch_chgtime = TRUE;
+		tdcp->c_touch_modtime = TRUE;
+		tdcp->c_flag |= C_MODIFIED;
+		hfs_incr_gencount(tdcp);
+		(void) hfs_update(tdvp, 0);
+	}
+
+	vnode_update_identity(fvp, tdvp, tcnp->cn_nameptr, tcnp->cn_namelen, tcnp->cn_hash,
+	    (VNODE_UPDATE_PARENT | VNODE_UPDATE_NAME));
+	vnode_update_identity(tvp, fdvp, fcnp->cn_nameptr, fcnp->cn_namelen, fcnp->cn_hash,
+	    (VNODE_UPDATE_PARENT | VNODE_UPDATE_NAME));
+	/* (a resource fork's vnode is named after its file: looked up again by that name from now on) */
+	if (fcp->c_rsrc_vp) {
+		cache_purge(fcp->c_rsrc_vp);
+	}
+	if (tcp->c_rsrc_vp) {
+		cache_purge(tcp->c_rsrc_vp);
+	}
+
+out:
+	if (got_cookie) {
+		cat_postflight(hfsmp, &cookie, p);
+	}
+	if (started_tr) {
+		hfs_end_transaction(hfsmp);
+	}
+	fdcp->c_flag &= ~C_DIR_MODIFICATION;
+	wakeup((caddr_t)&fdcp->c_flag);
+	if (fdvp != tdvp) {
+		tdcp->c_flag &= ~C_DIR_MODIFICATION;
+		wakeup((caddr_t)&tdcp->c_flag);
+	}
+unlock:
+	hfs_unlockfour(fdcp, fcp, tdcp, tcp);
+	return error;
+}
+
